# Production .env template -- copy to .env ON THE SERVER (never commit the real file).
# Differences from local dev's .env.example: every secret below MUST be changed from
# its dev default before this stack is reachable from the public internet.

# Neo4j -- generate a real password, e.g.: openssl rand -base64 24
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_TO_A_REAL_RANDOM_PASSWORD
NEO4J_DATABASE=neo4j

# Qdrant (internal-only in production, see docker-compose.prod.yml)
QDRANT_URL=http://qdrant:6333

# LLM -- real Gemini key required (this project has no mock provider)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# App
LOG_LEVEL=INFO
APP_ENV=prod

# Only needed if you enable the Caddy HTTPS proxy (docker compose --profile with-https).
# Point both as DNS A records at the server's IP before starting the proxy service --
# Caddy requests a Let's Encrypt certificate on first request to each domain.
DOMAIN_APP=app.example.com
DOMAIN_API=api.example.com
